{
  "name": "reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local read-aloud app: paste Markdown, hear it with sentence and word highlighting.",
  "scripts": {
    "start": "pnpm --filter web build && node server/main.ts",
    "dev": "concurrently -n server,web \"node --watch server/main.ts\" \"pnpm --filter web dev\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@met4citizen/headtts": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1"
  }
}
